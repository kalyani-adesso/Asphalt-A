# ==========================================
# Kotlin / Gradle
# ==========================================
*.iml
.kotlin
.gradle
**/build/
!src/**/build/
local.properties
captures
.externalNativeBuild
.cxx

# ==========================================
# iOS / Xcode / CocoaPods
# ==========================================

# Xcode user data
xcuserdata
*.xcuserdata
*.xccheckout
*.moved-aside
**/xcshareddata/WorkspaceSettings.xcsettings

# Keep shared project files, ignore user-specific ones
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# CocoaPods — generated dependencies (run `pod install` after cloning)
iosApp/Pods/
iosApp/Podfile.lock

